flowchart TB
    subgraph G1["① 首次激活 · 过期待回收 — 始终 0"]
        direction TB
        G1P["前置<br/>【卡券】可使用<br/>【数据】未可用=0 · 占用=0<br/>【过期待回收】— 不变（=0）"]
        G1S1["Step1 · 激活<br/>【卡券】可使用 → 已使用<br/>【数据】未可用 += 面额<br/>【过期待回收】— 不变"]
        G1S2["Step2 · 开仓<br/>【卡券】已使用<br/>【数据】未可用 ↓ · 占用 ↑<br/>【过期待回收】— 不变"]
        G1P --> G1S1 --> G1S2
    end

    subgraph G2["② 激活新券 · 过期待回收 －"]
        direction TB
        G2P["前置<br/>【卡券】A 已失效 · B 可使用<br/>【过期待回收】A > 0"]
        G2S1["Step1 · 激活 B<br/>【过期待回收】— 不变"]
        G2S2["Step2 · 替换归属<br/>【过期待回收】A －（替换掉的占用额）<br/>B 占用 ↑"]
        G2S3["Step3 · 继续清算<br/>【过期待回收】A －（剩余可收部分）"]
        G2S4["Step4 · 收完<br/>【过期待回收】A = 0"]
        G2P --> G2S1 --> G2S2 --> G2S3 --> G2S4
    end

    subgraph G3["③ 划转转出 · 过期待回收 ＋"]
        direction TB
        G3P["前置<br/>【过期待回收】— 不变（=0）"]
        G3S1["Step1 · 收未可用<br/>【过期待回收】— 不变"]
        G3S2["Step2 · 标占用<br/>【过期待回收】＋ 占用额（若占用>0）<br/>占用 → 0"]
        G3S3["Step3 · 放行划转<br/>【过期待回收】— 不变 · 等 ②④⑤ 减"]
        G3P --> G3S1 --> G3S2 --> G3S3
    end

    subgraph G4["④ 平仓 · 分两种"]
        direction TB
        G4P["前置<br/>【过期待回收】0 或 >0"]
        G4S1["Step1 · 结算<br/>【过期待回收】— 不变"]
        G4S2["Step2a · 券仍有效<br/>【过期待回收】— 不变（仍为 0）"]
        G4S3["Step2b · 券已失效<br/>【过期待回收】－ 释放额"]
        G4S4["Step3 · 收完<br/>【过期待回收】= 0"]
        G4P --> G4S1
        G4S1 --> G4S2
        G4S1 --> G4S3
        G4S3 --> G4S4
    end

    subgraph G5["⑤ 本金划入 · 过期待回收 －"]
        direction TB
        G5P["前置<br/>【过期待回收】> 0"]
        G5S1["Step1 · 划入<br/>【过期待回收】— 不变"]
        G5S2["Step2 · 清算<br/>【过期待回收】－ 可收部分"]
        G5S3["Step3 · 收完<br/>【过期待回收】= 0"]
        G5P --> G5S1 --> G5S2 --> G5S3
    end

    subgraph G6["⑥ 到期 · 过期待回收 ＋（同③）"]
        direction TB
        G6P["前置<br/>【过期待回收】— 不变（=0）"]
        G6S1["Step1 · 收未可用<br/>【过期待回收】— 不变"]
        G6S2["Step2 · 标占用<br/>【过期待回收】＋ 占用额（若占用>0）"]
        G6S3["Step3 · 后续<br/>【过期待回收】>0 → 等 ②④⑤ 减"]
        G6P --> G6S1 --> G6S2 --> G6S3
    end

    style G2S2 fill:#ecfdf5
    style G2S3 fill:#ecfdf5
    style G3S2 fill:#fef2f2
    style G4S3 fill:#ecfdf5
    style G5S2 fill:#ecfdf5
    style G6S2 fill:#fef2f2
