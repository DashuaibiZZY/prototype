flowchart TB
    subgraph G1["① 用户 · 首次激活新体验金"]
        direction TB
        G1P["前置<br/>【卡券】可使用<br/>【数据】未可用=0 · 占用=0 · 过期待回收=0"]
        G1S1["Step1 · 激活<br/>【卡券】可使用 → 已使用<br/>【数据】未可用 += 面额"]
        G1S2["Step2 · 开仓（后续）<br/>【卡券】已使用（不变）<br/>【数据】未可用 ↓ · 占用 ↑"]
        G1P --> G1S1 --> G1S2
    end

    subgraph G2["② 用户 · 激活新券（当前有过期待回收）"]
        direction TB
        G2P["前置<br/>【卡券】A 已失效 · B 可使用<br/>【数据】A 过期待回收 > 0"]
        G2S1["Step1 · 激活 B<br/>【卡券】B：可使用 → 已使用<br/>【数据】B 未可用 += 面额"]
        G2S2["Step2 · 替换占用归属<br/>【卡券】A 仍已失效 · B 已使用<br/>【数据】A 过期待回收 ↓ · B 占用 ↑"]
        G2S3["Step3 · 继续清算（若有剩余）<br/>【卡券】A 仍已失效<br/>【数据】B 未可用/账户可用 → 已回收 · A 过期待回收 ↓"]
        G2S4["Step4 · 收完<br/>【卡券】A 终态 · B 已使用<br/>【数据】A 过期待回收 = 0"]
        G2P --> G2S1 --> G2S2 --> G2S3 --> G2S4
    end

    subgraph G3["③ 用户 · 划转转出（交易→资金）"]
        direction TB
        G3P["前置<br/>【卡券】已使用<br/>【数据】未可用 ≥0 · 占用 ≥0 · 过期待回收=0"]
        G3S1["Step1 · 收未可用<br/>【卡券】仍已使用<br/>【数据】未可用 → 已回收 · 未可用=0"]
        G3S2["Step2 · 标占用<br/>【卡券】已使用 → 已失效<br/>【数据】占用 → 过期待回收 · 占用=0"]
        G3S3["Step3 · 放行划转<br/>【卡券】已失效<br/>【数据】可转出不含体验金 · ❌ 不减仓"]
        G3P --> G3S1 --> G3S2 --> G3S3
    end

    subgraph G4["④ 用户 · 平仓"]
        direction TB
        G4P["前置<br/>【卡券】已使用 或 已失效<br/>【数据】占用 ≥0 和/或 过期待回收 ≥0"]
        G4S1["Step1 · 结算<br/>【卡券】不变<br/>【数据】已消耗费用 ↑ · 已消耗亏损 ↑"]
        G4S2["Step2a · 券仍有效<br/>【卡券】已使用<br/>【数据】占用 ↓ → 未可用 或 已消耗"]
        G4S3["Step2b · 券已失效<br/>【卡券】已失效<br/>【数据】释放过期占用 → 已回收 · 过期待回收 ↓"]
        G4S4["Step3 · 收完（若适用）<br/>【卡券】已失效 · 终态<br/>【数据】过期待回收 = 0"]
        G4P --> G4S1
        G4S1 --> G4S2
        G4S1 --> G4S3
        G4S3 --> G4S4
    end

    subgraph G5["⑤ 用户 · 本金划入（资金→交易）"]
        direction TB
        G5P["前置<br/>【卡券】已失效<br/>【数据】过期待回收 > 0"]
        G5S1["Step1 · 划入<br/>【卡券】已失效（不变）<br/>【数据】账户可用保证金 ↑"]
        G5S2["Step2 · 清算<br/>【卡券】已失效<br/>【数据】过期待回收 → 已回收 · 过期待回收 ↓"]
        G5S3["Step3 · 收完<br/>【卡券】已失效 · 终态<br/>【数据】过期待回收 = 0"]
        G5P --> G5S1 --> G5S2 --> G5S3
    end

    subgraph G6["⑥ 系统 · 开仓有效期到期"]
        direction TB
        G6P["前置<br/>【卡券】已使用<br/>【数据】未可用 ≥0 · 占用 ≥0"]
        G6S1["Step1 · 收未可用<br/>【卡券】仍已使用<br/>【数据】未可用 → 已回收 · 未可用=0"]
        G6S2["Step2 · 标占用<br/>【卡券】已使用 → 已失效<br/>【数据】占用 → 过期待回收 · 占用=0"]
        G6S3["Step3 · 后续<br/>【卡券】已失效<br/>【数据】过期待回收>0 → 等 ②④⑤ 收完"]
        G6P --> G6S1 --> G6S2 --> G6S3
    end

    style G1P fill:#f8fafc
    style G2P fill:#f8fafc
    style G3P fill:#f8fafc
    style G4P fill:#f8fafc
    style G5P fill:#f8fafc
    style G6P fill:#f8fafc
