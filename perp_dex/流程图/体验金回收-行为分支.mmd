flowchart TB
    subgraph G1["① 首次激活"]
        direction TB
        G1P["前置<br/>【卡券】可使用<br/>【数据】未可用=0 · 占用=0"]
        G1S1["Step1 · 激活<br/>【卡券】可使用 → 已使用<br/>【数据】未可用 += 面额"]
        G1S2["Step2 · 开仓<br/>【卡券】已使用<br/>【数据】未可用 ↓ · 占用 ↑"]
        G1P --> G1S1 --> G1S2
    end

    subgraph G2["② 激活新券 · 过期待回收 －"]
        direction TB
        G2P["前置<br/>【卡券】A 已失效 · B 可使用<br/>【数据】A 过期待回收 > 0"]
        G2S1["Step1 · 激活 B<br/>【数据】B 未可用 += 面额"]
        G2S2["Step2 · 替换归属<br/>【数据】A 过期待回收 ↓ · B 占用 ↑"]
        G2S3["Step3 · 继续清算<br/>【数据】→ 已回收 · A 过期待回收 ↓"]
        G2S4["Step4 · 收完<br/>【数据】A 过期待回收 = 0"]
        G2P --> G2S1 --> G2S2 --> G2S3 --> G2S4
    end

    subgraph G3["③ 划转转出 · 过期待回收 ＋"]
        direction TB
        G3P["前置<br/>【卡券】已使用<br/>【数据】过期待回收 = 0"]
        G3S1["Step1 · 收未可用<br/>【数据】未可用 → 已回收"]
        G3S2["Step2 · 标占用<br/>【卡券】→ 已失效<br/>【数据】占用 → 过期待回收"]
        G3S3["Step3 · 放行划转<br/>【卡券】已失效"]
        G3P --> G3S1 --> G3S2 --> G3S3
    end

    subgraph G4["④ 平仓"]
        direction TB
        G4P["前置<br/>【卡券】已使用 或 已失效"]
        G4S1["Step1 · 结算<br/>【数据】已消耗费用 ↑ · 已消耗亏损 ↑"]
        G4S2["Step2a · 券仍有效<br/>【数据】占用 ↓ → 未可用/已消耗"]
        G4S3["Step2b · 券已失效<br/>【数据】过期待回收 ↓ → 已回收"]
        G4S4["Step3 · 收完<br/>【数据】过期待回收 = 0"]
        G4P --> G4S1
        G4S1 --> G4S2
        G4S1 --> G4S3
        G4S3 --> G4S4
    end

    subgraph G5["⑤ 本金划入 · 过期待回收 －"]
        direction TB
        G5P["前置<br/>【卡券】已失效<br/>【数据】过期待回收 > 0"]
        G5S1["Step1 · 划入<br/>【数据】账户可用 ↑"]
        G5S2["Step2 · 清算<br/>【数据】过期待回收 ↓ → 已回收"]
        G5S3["Step3 · 收完<br/>【数据】过期待回收 = 0"]
        G5P --> G5S1 --> G5S2 --> G5S3
    end

    subgraph G6["⑥ 到期 · 同③ Step1–2"]
        direction TB
        G6P["前置<br/>【卡券】已使用"]
        G6S1["Step1 · 收未可用<br/>【数据】未可用 → 已回收"]
        G6S2["Step2 · 标占用<br/>【卡券】→ 已失效<br/>【数据】占用 → 过期待回收"]
        G6S3["Step3 · 后续<br/>【数据】等 ②④⑤ 收完"]
        G6P --> G6S1 --> G6S2 --> G6S3
    end
