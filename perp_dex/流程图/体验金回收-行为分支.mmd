flowchart TB
    START(["行为触发"])

    START --> B1{哪种行为?}

    B1 -->|首次激活新体验金| F1
    B1 -->|激活新券·有过期待回收| F2
    B1 -->|划转转出| F3
    B1 -->|平仓| F4
    B1 -->|本金划入合约| F5
    B1 -->|开仓有效期到期| F6

    subgraph F1["① 首次激活"]
        F1A["卡券: 可使用→已使用<br/>未可用 += 面额"]
    end

    subgraph F2["② 激活·有过期待回收"]
        F2A["新券: 可使用→已使用<br/>未可用(新) += 面额"]
        F2B["替换仓位过期占用归属→新券占用<br/>过期待回收 ↓"]
        F2C["有余额则继续回收至已回收"]
    end

    subgraph F3["③ 划转转出"]
        F3A["未可用 → 已回收（全量）"]
        F3B["占用 → 过期待回收<br/>❌ 不减仓 ❌ 不抽占用"]
        F3C["卡券 → 已失效<br/>确认后放行划转"]
    end

    subgraph F4["④ 平仓"]
        F4A["结算本券: 已消耗费用↑ / 已消耗亏损↑"]
        F4B{卡券已失效<br/>且过期待回收>0?}
        F4B -->|是| F4C["释放的过期占用 → 已回收<br/>过期待回收 ↓"]
        F4B -->|否·券仍有效| F4D["占用 ↓ → 未可用（或已消耗）"]
    end

    subgraph F5["⑤ 本金划入"]
        F5A{过期待回收>0?}
        F5A -->|是| F5B["从新可用保证金扣待回收<br/>→ 已回收 · 过期待回收 ↓"]
        F5A -->|否| F5C["无体验金回收动作"]
    end

    subgraph F6["⑥ 开仓有效期到期"]
        F6A["同③: 未可用→已回收<br/>占用→过期待回收<br/>卡券→已失效"]
    end
