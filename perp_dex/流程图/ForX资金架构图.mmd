%% 在线访问：https://dashuaibizzy.github.io/prototype/perp_dex/流程图/ForX资金架构图.svg
%% 改版后执行：npx @mermaid-js/mermaid-cli -i ForX资金架构图.mmd -o ForX资金架构图.svg -b white
flowchart TB
    subgraph DEF["<b>钱包概念定义</b>"]
        direction LR
        DEF_HOT["<div style='text-align:left;line-height:1.6'><b>Cobo 热钱包</b><br/><span style='color:#465D72'>支持 API Key 程序化调用的钱包</span></div>"]
        DEF_WARM["<div style='text-align:left;line-height:1.6'><b>Cobo 温钱包</b><br/><span style='color:#63478A'>仅 Portal 操作 · 无 API Key</span></div>"]
        DEF_NOTE["<div style='text-align:left;line-height:1.6'><b style='color:#63478A'>备注</b><br/><span style='color:#63478A'>热转温、温转热均需人工发起<br/>财务与风控审批后签名出款</span></div>"]
        DEF_HOT ~~~ DEF_WARM ~~~ DEF_NOTE
    end

    EXT["<b>用户外部钱包</b>"]
    PRIVY["<b>Privy 用户钱包</b><br/><span style='color:#465D72'>用户充值入口</span>"]
    SWAP["<b>Swap 结算</b><br/><span style='color:#465D72'>用户确认兑换</span>"]
    ADMIN["<b>充提后台</b><br/><span style='color:#465D72'>按链配置收益收款地址</span>"]

    subgraph UV["<div style='width:420px;text-align:left'><b>Cobo 用户资产 Vault</b></div>"]
        direction TB
        DEP["<b>Cobo 充值地址</b><br/><span style='color:#465D72'>每位用户独立分配 · 统一归集到热钱包</span>"]
        HOT["<b>Cobo 热钱包</b><br/><span style='color:#465D72'>归集到账 · 日常出款</span>"]
    end

    SWAP_FEE["<b>平台 Swap 费用</b><br/><span style='color:#63478A'><b>（专用温钱包）</b></span>"]

    WD["<b>用户提现地址</b>"]

    subgraph GRP_N["<b>平台资产底仓储备</b>（专用温钱包）"]
        direction TB
        subgraph GRP_N_W["<span style='color:#63478A;font-size:12px'>多个同类钱包，根据资金量分配调整</span>"]
            direction LR
            N1["底仓钱包 N1"]
            N2["底仓钱包 N2"]
            N3["…"]
            NN["底仓钱包 N"]
            N1 ~~~ N2 ~~~ N3 ~~~ NN
        end
        N_NOTE["<div style='text-align:left;line-height:1.55'><span style='color:#465D72'><b>说明：</b>专用存储平台自有资产，直接入温钱包，<br/>不先充 Cobo 热钱包；Cobo 热钱包充提不足时再划拨补足</span></div>"]
        GRP_N_W ~~~ N_NOTE
    end

    subgraph GRP_F["<b>平台手续费收入</b>（专用温钱包）"]
        direction TB
        subgraph GRP_F_W["<span style='color:#63478A;font-size:12px'>多个同类钱包，根据资金量分配调整</span>"]
            direction LR
            F1["手续费钱包 F1"]
            F2["手续费钱包 F2"]
            F3["…"]
            FF["手续费钱包 F"]
            F1 ~~~ F2 ~~~ F3 ~~~ FF
        end
        F_NOTE["<div style='text-align:left;line-height:1.55'><span style='color:#465D72'><b>说明：</b>专用存储平台手续费收入，定期从 Cobo 热钱包<br/>转入温钱包，但须保留充提底仓资金</span></div>"]
        GRP_F_W ~~~ F_NOTE
    end

    subgraph GRP_U["<b>用户资产存储</b>（专用温钱包）"]
        direction TB
        subgraph GRP_U_W["<span style='color:#63478A;font-size:12px'>多个同类钱包，根据资金量分配调整</span>"]
            direction LR
            U1["用户钱包 U1"]
            U2["用户钱包 U2"]
            U3["…"]
            UU["用户钱包 U"]
            U1 ~~~ U2 ~~~ U3 ~~~ UU
        end
        U_NOTE["<div style='text-align:left;line-height:1.55'><span style='color:#465D72'><b>说明：</b>专用存储平台用户充值资金中，超出充提底仓需求<br/>的部分，定期从 Cobo 热钱包转入温钱包</span></div>"]
        GRP_U_W ~~~ U_NOTE
    end

    %% 顶部概念定义锚定
    DEF ~~~ EXT

    %% 主资金流与配置
    EXT -->|"充值"| PRIVY
    PRIVY --> SWAP
    ADMIN -. "按链配置收益收款地址" .-> SWAP

    PRIVY -->|"直接转入支持币种"| DEP
    SWAP -->|"用户兑换净额"| DEP
    SWAP -->|"平台 Swap 费用"| SWAP_FEE

    DEP -->|"Cobo 自动归集"| HOT
    HOT -->|"风控通过后出款"| WD

    %% 热钱包与 3 个专用温钱包组双向划转
    HOT <-->|"热温双向划转"| GRP_N
    HOT <-->|"热温双向划转"| GRP_F
    HOT <-->|"热温双向划转"| GRP_U

    classDef defGroup fill:#F8FAFC,stroke:#CBD5E1,stroke-width:1.5px,color:#182B41
    classDef defHot fill:#FFFFFF,stroke:#235DB3,stroke-width:1.5px,color:#182B41
    classDef defWarm fill:#F6F1FA,stroke:#BBA9CE,stroke-width:1.5px,color:#182B41
    classDef defNote fill:#FAF5FF,stroke:#BBA9CE,stroke-width:1.5px,stroke-dasharray: 4 3,color:#63478A
    classDef entry fill:#FFFFFF,stroke:#9DB4CD,stroke-width:1.5px,color:#182B41
    classDef admin fill:#F7F9FC,stroke:#9DB4CD,stroke-width:1.5px,color:#182B41
    classDef vaultUser fill:#F2F7FF,stroke:#A3BBDB,stroke-width:2px,color:#182B41
    classDef hotWallet fill:#FFFFFF,stroke:#235DB3,stroke-width:2px,color:#182B41
    classDef swapFee fill:#F6F1FA,stroke:#BBA9CE,stroke-width:1.5px,color:#182B41
    classDef warmGroup fill:#FFFFFF,stroke:#BBA9CE,stroke-width:2px,color:#182B41
    classDef warmInner fill:#FAF7FD,stroke:#DDD0EC,stroke-width:1px,color:#63478A
    classDef warmTile fill:#F6F1FA,stroke:#BBA9CE,stroke-width:1.5px,color:#63478A
    classDef warmNote fill:#FFFFFF,stroke:#E2D9EE,stroke-width:1px,stroke-dasharray: 3 3,color:#465D72

    class DEF defGroup
    class DEF_HOT defHot
    class DEF_WARM defWarm
    class DEF_NOTE defNote
    class EXT,PRIVY,SWAP,DEP,WD entry
    class ADMIN admin
    class UV vaultUser
    class HOT hotWallet
    class SWAP_FEE swapFee
    class GRP_N,GRP_F,GRP_U warmGroup
    class GRP_N_W,GRP_F_W,GRP_U_W warmInner
    class N1,N2,N3,NN,F1,F2,F3,FF,U1,U2,U3,UU warmTile
    class N_NOTE,F_NOTE,U_NOTE warmNote

    %% Link indices:
    %% 0,1: DEF_HOT~~~DEF_WARM~~~DEF_NOTE
    %% 2,3,4: N1~~~N2~~~N3~~~NN | 5: GRP_N_W~~~N_NOTE
    %% 6,7,8: F1~~~F2~~~F3~~~FF | 9: GRP_F_W~~~F_NOTE
    %% 10,11,12: U1~~~U2~~~U3~~~UU | 13: GRP_U_W~~~U_NOTE
    %% 14: DEF~~~EXT
    %% 15: EXT-->PRIVY, 16: PRIVY-->SWAP, 17: ADMIN-.->SWAP
    %% 18: PRIVY-->DEP, 19: SWAP-->DEP, 20: SWAP-->SWAP_FEE
    %% 21: DEP-->HOT, 22: HOT-->WD
    %% 23,24,25: HOT<-->GRP_N, GRP_F, GRP_U
    linkStyle 15,16,18,19,21,22 stroke:#235DB3,stroke-width:2px
    linkStyle 17 stroke:#51687F,stroke-width:1.8px,stroke-dasharray:5 4
    linkStyle 20 stroke:#1B7471,stroke-width:2px
    linkStyle 23,24,25 stroke:#63478A,stroke-width:2px
