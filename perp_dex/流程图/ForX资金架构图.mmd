%% 在线访问：https://dashuaibizzy.github.io/prototype/perp_dex/流程图/ForX资金架构图.svg
%% 说明：ForX资金架构图.svg 由同目录 python3 render_forx_fund_flow.py 精确排版生成；本 .mmd 同步维护架构结构便于文本评审
flowchart TB
    subgraph DEF["<b>Cobo 钱包与 Vault 概念定义（基于 Cobo 定义逻辑）</b>"]
        direction LR
        DEF_HOT["<div style='text-align:left;line-height:1.6'><b>Cobo 热钱包（Cobo 定义）</b><br/><span style='color:#465D72'>支持 API Key 程序化调用的钱包</span></div>"]
        DEF_WARM["<div style='text-align:left;line-height:1.6'><b>Cobo 温钱包（Cobo 定义）</b><br/><span style='color:#63478A'>仅 Portal 操作 · 无 API Key</span></div>"]
        DEF_VAULT["<div style='text-align:left;line-height:1.6'><b>Cobo Vault（权限边界）</b><br/><span style='color:#1B7471'>Vault 创建并管理钱包，钱包用于存钱<br/>不同 Vault 之间权限严格隔离</span></div>"]
        DEF_NOTE["<div style='text-align:left;line-height:1.6'><b style='color:#63478A'>备注（热温划转规则）</b><br/><span style='color:#63478A'>热转温、温转热均需人工发起<br/>财务与风控审批后签名出款</span></div>"]
        DEF_HOT ~~~ DEF_WARM ~~~ DEF_VAULT ~~~ DEF_NOTE
    end

    EXT["<b>用户外部钱包</b>"]
    PRIVY["<b>Privy 用户钱包</b><br/><span style='color:#465D72'>用户充值入口</span>"]
    SWAP["<b>Swap 结算</b><br/><span style='color:#465D72'>用户确认兑换</span>"]
    ADMIN["<b>充提后台</b><br/><span style='color:#465D72'>按链配置收益收款地址</span>"]

    subgraph VAULT_AREA[" "]
        direction LR

        subgraph LEFT_COL[" "]
            direction TB

            %% 独立 Vault 1：Cobo 热钱包 Vault（位置不变）
            subgraph UV["<div style='width:460px;text-align:left;line-height:1.4'><b>Cobo 热钱包 Vault</b><br/><span style='font-size:12px;color:#235DB3'>独立 Vault 权限边界</span></div>"]
                direction TB
                DEP["<b>Cobo 充值地址</b><br/><span style='color:#465D72'>每位用户独立分配 · 统一归集到热钱包</span>"]
                HOT["<b>Cobo 热钱包</b><br/><span style='color:#465D72'>归集到账 · 日常出款（独立 Vault）</span><br/><span style='color:#235DB3'>提币密钥多签（MPC 2-of-2）：自托管服务器 TSS Node（1 分片）+ Cobo 官方托管（1 分片）</span>"]
            end

            subgraph USER_BOTTOM[" "]
                direction LR
                WD["<b>用户提现地址</b>"]

                %% 独立 Vault 2：用户资产存储 Vault（热钱包下侧）
                subgraph VAULT_U["<b>用户资产存储 Vault（独立 Vault · 专用温钱包）</b>"]
                    direction TB
                    subgraph GRP_U_W["<span style='color:#63478A;font-size:12px'>多个同类钱包，根据资金量分配调整</span>"]
                        direction LR
                        U1["用户钱包 U1"]
                        U2["用户钱包 U2"]
                        U3["…"]
                        UU["用户钱包 U"]
                        U1 ~~~ U2 ~~~ U3 ~~~ UU
                    end
                    U_NOTE["<div style='text-align:left;line-height:1.55'><span style='color:#465D72'><b>说明：</b>专用存储平台用户充值资金中，超出充提底仓需求<br/>的部分，定期从 Cobo 热钱包转入温钱包</span></div>"]
                    U_MPC["<div style='text-align:left;line-height:1.55'><b>提币密钥多签方案（可选方案 A / B）</b><br/><span style='color:#63478A'>方案 A（MPC 2-of-2 + Cobo 审批流）：投资人（Cobo App，1 分片）+ Cobo 官方（1 分片）；经 KEdward + 集团财务审批后签名</span><br/><span style='color:#63478A'>方案 B（MPC 3-of-4 门限多签）：投资人、集团财务、KEdward（Cobo App 各 1 分片）+ Cobo 官方（1 分片）；4 分片 3 门限（注：Cobo 官方为必签分片）</span></div>"]
                    GRP_U_W ~~~ U_NOTE ~~~ U_MPC
                end
            end

            DEP -->|"Cobo 自动归集"| HOT
            HOT -->|"风控通过后出款"| WD
            HOT <-->|"热温双向划转"| VAULT_U
        end

        subgraph RIGHT_COL[" "]
            direction TB

            %% 独立 Vault 3：平台收入 Vault（平台 Swap 费用 + 平台手续费收入）
            subgraph VAULT_REV["<b>平台收入 Vault（独立 Vault · 统一管理 2 类平台收入专用温钱包）</b>"]
                direction TB

                subgraph GRP_S["<b>平台 Swap 费用</b>（专用温钱包）"]
                    direction TB
                    subgraph GRP_S_W["<span style='color:#1B7471;font-size:12px'>多个同类钱包，根据资金量分配调整</span>"]
                        direction LR
                        S1["Swap钱包 S1"]
                        S2["Swap钱包 S2"]
                        S3["…"]
                        SS["Swap钱包 S"]
                        S1 ~~~ S2 ~~~ S3 ~~~ SS
                    end
                    S_NOTE["<div style='text-align:left;line-height:1.55'><span style='color:#465D72'><b>说明：</b>专收平台应得的 Swap 手续费，<br/>由 Swap 结算直接转入对应链收款钱包</span></div>"]
                    GRP_S_W ~~~ S_NOTE
                end

                subgraph GRP_F["<b>平台手续费收入</b>（专用温钱包）"]
                    direction TB
                    subgraph GRP_F_W["<span style='color:#63478A;font-size:12px'>多个同类钱包，根据资金量分配调整</span>"]
                        direction LR
                        F1["手续费钱包 F1"]
                        F2["手续费钱包 F2"]
                        F3["…"]
                        FF["手续费钱包 F"]
                        F1 ~~~ F2 ~~~ F3 ~~~ FF
                    end
                    F_NOTE["<div style='text-align:left;line-height:1.55'><span style='color:#465D72'><b>说明：</b>专用存储平台手续费收入，定期从 Cobo 热钱包<br/>转入温钱包，但须保留充提底仓资金</span></div>"]
                    GRP_F_W ~~~ F_NOTE
                end

                REV_MPC["<div style='text-align:left;line-height:1.55'><b>提币密钥多签方案（MPC 2-of-2）</b><br/><span style='color:#1B7471'>双分片协同签名：KEdward 通过 Cobo App 持有（1 分片）+ Cobo 官方托管（1 分片）</span></div>"]

                GRP_S ~~~ GRP_F ~~~ REV_MPC
            end

            %% 独立 Vault 4：平台资产底仓 Vault（平台资产底仓储备）
            subgraph VAULT_RES["<b>平台资产底仓 Vault（独立 Vault · 专用温钱包）</b>"]
                direction TB

                subgraph GRP_N["<b>平台资产底仓储备</b>（专用温钱包）"]
                    direction TB
                    subgraph GRP_N_W["<span style='color:#63478A;font-size:12px'>多个同类钱包，根据资金量分配调整</span>"]
                        direction LR
                        N1["底仓钱包 N1"]
                        N2["底仓钱包 N2"]
                        N3["…"]
                        NN["底仓钱包 N"]
                        N1 ~~~ N2 ~~~ N3 ~~~ NN
                    end
                    N_NOTE["<div style='text-align:left;line-height:1.55'><span style='color:#465D72'><b>说明：</b>专用存储平台自有资产，直接入温钱包，<br/>不先充 Cobo 热钱包；Cobo 热钱包充提不足时再划拨补足</span></div>"]
                    GRP_N_W ~~~ N_NOTE
                end

                RES_MPC["<div style='text-align:left;line-height:1.55'><b>提币密钥多签方案（可选方案 A / B）</b><br/><span style='color:#B4690E'>方案 A（MPC 2-of-2 + Cobo 审批流）：投资人（Cobo App，1 分片）+ Cobo 官方托管（1 分片）；经 KEdward + 集团财务审批后签名</span><br/><span style='color:#B4690E'>方案 B（MPC 3-of-4 门限多签）：投资人、集团财务、KEdward（Cobo App 各 1 分片）+ Cobo 官方（1 分片）；4 分片 3 门限（注：Cobo 官方为必签分片）</span></div>"]

                GRP_N ~~~ RES_MPC
            end

            VAULT_REV ~~~ VAULT_RES
        end

        %% 热钱包与右侧「平台收入 Vault」「平台资产底仓 Vault」双向划转
        HOT <-->|"热温双向划转"| GRP_F
        HOT <-->|"热温双向划转"| GRP_N
    end

    %% 顶部概念定义锚定
    DEF ~~~ EXT

    %% 顶层入口与 Swap 资金流
    EXT -->|"充值"| PRIVY
    PRIVY --> SWAP
    ADMIN -. "按链配置收益收款地址" .-> SWAP

    PRIVY -->|"直接转入支持币种"| DEP
    SWAP -->|"用户兑换净额"| DEP
    SWAP -->|"平台 Swap 费用"| GRP_S

    classDef invisible fill:none,stroke:none
    classDef defGroup fill:#F8FAFC,stroke:#CBD5E1,stroke-width:1.5px,color:#182B41
    classDef defHot fill:#FFFFFF,stroke:#235DB3,stroke-width:1.5px,color:#182B41
    classDef defWarm fill:#F6F1FA,stroke:#BBA9CE,stroke-width:1.5px,color:#182B41
    classDef defVault fill:#F0F8F7,stroke:#88B8B1,stroke-width:1.5px,color:#182B41
    classDef defNote fill:#FAF5FF,stroke:#BBA9CE,stroke-width:1.5px,stroke-dasharray: 4 3,color:#63478A
    classDef entry fill:#FFFFFF,stroke:#9DB4CD,stroke-width:1.5px,color:#182B41
    classDef admin fill:#F7F9FC,stroke:#9DB4CD,stroke-width:1.5px,color:#182B41
    classDef vaultHot fill:#F2F7FF,stroke:#235DB3,stroke-width:2px,color:#182B41
    classDef vaultUserWarm fill:#F8F4FC,stroke:#7C5DA3,stroke-width:2px,color:#182B41
    classDef vaultPlat fill:#F0F8F7,stroke:#1B7471,stroke-width:2px,color:#182B41
    classDef vaultReserve fill:#FDF9F0,stroke:#B4690E,stroke-width:2px,color:#182B41
    classDef hotWallet fill:#FFFFFF,stroke:#235DB3,stroke-width:2px,color:#182B41
    classDef warmGroup fill:#FFFFFF,stroke:#BBA9CE,stroke-width:1.5px,color:#182B41
    classDef swapGroup fill:#FFFFFF,stroke:#88B8B1,stroke-width:1.5px,color:#182B41
    classDef warmInner fill:#FAF7FD,stroke:#DDD0EC,stroke-width:1px,color:#63478A
    classDef swapInner fill:#F4FAF9,stroke:#C2DFDA,stroke-width:1px,color:#1B7471
    classDef warmTile fill:#F6F1FA,stroke:#BBA9CE,stroke-width:1.5px,color:#63478A
    classDef swapTile fill:#EAF5F3,stroke:#88B8B1,stroke-width:1.5px,color:#1B7471
    classDef warmNote fill:#FFFFFF,stroke:#E2D9EE,stroke-width:1px,stroke-dasharray: 3 3,color:#465D72

    class VAULT_AREA,LEFT_COL,RIGHT_COL,USER_BOTTOM invisible
    class DEF defGroup
    class DEF_HOT defHot
    class DEF_WARM defWarm
    class DEF_VAULT defVault
    class DEF_NOTE defNote
    class EXT,PRIVY,SWAP,DEP,WD entry
    class ADMIN admin
    class UV vaultHot
    class VAULT_U vaultUserWarm
    class VAULT_REV vaultPlat
    class VAULT_RES vaultReserve
    class HOT hotWallet
    class GRP_N,GRP_F warmGroup
    class GRP_S swapGroup
    class GRP_U_W,GRP_N_W,GRP_F_W warmInner
    class GRP_S_W swapInner
    class U1,U2,U3,UU,N1,N2,N3,NN,F1,F2,F3,FF warmTile
    class S1,S2,S3,SS swapTile
    class U_NOTE,S_NOTE,N_NOTE,F_NOTE warmNote

    %% Link indices:
    %% 0,1,2: DEF_HOT~~~DEF_WARM~~~DEF_VAULT~~~DEF_NOTE
    %% 3,4,5: U1~~~U2~~~U3~~~UU | 6: GRP_U_W~~~U_NOTE
    %% 7: DEP-->HOT | 8: HOT-->WD | 9: HOT<-->VAULT_U
    %% 10,11,12: S1~~~S2~~~S3~~~SS | 13: GRP_S_W~~~S_NOTE
    %% 14,15,16: N1~~~N2~~~N3~~~NN | 17: GRP_N_W~~~N_NOTE
    %% 18,19,20: F1~~~F2~~~F3~~~FF | 21: GRP_F_W~~~F_NOTE
    %% 22,23: GRP_S~~~GRP_N~~~GRP_F
    %% 24: HOT<-->GRP_N | 25: HOT<-->GRP_F
    %% 26: DEF~~~EXT
    %% 27: EXT-->PRIVY | 28: PRIVY-->SWAP | 29: ADMIN-.->SWAP
    %% 30: PRIVY-->DEP | 31: SWAP-->DEP | 32: SWAP-->GRP_S
    linkStyle 7,8,27,28,30,31 stroke:#235DB3,stroke-width:2px
    linkStyle 29 stroke:#51687F,stroke-width:1.8px,stroke-dasharray:5 4
    linkStyle 32 stroke:#1B7471,stroke-width:2px
    linkStyle 9,24,25 stroke:#63478A,stroke-width:2px
