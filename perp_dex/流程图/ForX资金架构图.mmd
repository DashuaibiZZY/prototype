%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "PingFang SC, Microsoft YaHei, WenQuanYi Micro Hei, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#FFFFFF",
    "primaryTextColor": "#182B41",
    "primaryBorderColor": "#9DB4CD",
    "lineColor": "#235DB3",
    "edgeLabelBackground": "#FFFFFF",
    "clusterBkg": "#F8FAFC",
    "clusterBorder": "#CBD5E1"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "basis",
