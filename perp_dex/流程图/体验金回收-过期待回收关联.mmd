flowchart TB
    O["体验金占用保证金<br/>卡券 = 已使用"]

    subgraph 新增["过期待回收 ＋ 新增（仅触发回收）"]
        direction TB
        P1["③ 划转转出 · Step2"]
        P2["⑥ 开仓有效期到期 · Step2"]
        P3["上限 / 风控 · 同 Step2"]
    end

    PENDING["过期待回收占用保证金<br/>卡券 = 已失效"]

    subgraph 减少["过期待回收 － 减少（仅清算）"]
        direction TB
        M1["② 激活新券 · Step2–3"]
        M2["④ 平仓 · Step2b（券已失效）"]
        M3["⑤ 本金划入 · Step2"]
    end

    R["已回收体验金金额"]

    subgraph 不变["过期待回收 — 不变"]
        direction TB
        N1["① 首次激活 / 开仓"]
        N2["④ 平仓 · Step2a（券仍有效）"]
        N3["③ Step1 · ⑤ Step1"]
    end

    O -->|"触发回收<br/>过期待回收 += 占用额"| PENDING
    P1 --> PENDING
    P2 --> PENDING
    P3 --> PENDING

    PENDING -->|"清算<br/>过期待回收 ↓ → 已回收"| R
    M1 --> R
    M2 --> R
    M3 --> R

    classDef cUsed fill:#eff6ff,stroke:#3b82f6,color:#1e40af
    classDef cInvalid fill:#fff7ed,stroke:#f97316,color:#9a3412
    classDef dOcc fill:#e0e7ff,stroke:#4f46e5,color:#312e81
    classDef dPending fill:#ffedd5,stroke:#ea580c,color:#9a3412
    classDef dReclaimed fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef neutral fill:#f8fafc,stroke:#cbd5e1,color:#334155

    class O dOcc
    class PENDING dPending
    class R dReclaimed
    class P1,P2,P3,M1,M2,M3,N1,N2,N3 neutral
