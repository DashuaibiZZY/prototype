flowchart TB
    subgraph 占用侧["体验金占用保证金"]
        O["占用 > 0<br/>卡券 = 已使用"]
    end

    subgraph 新增["过期待回收 ＋ 新增（仅触发回收）"]
        direction TB
        P1["③ 划转转出 · Step2"]
        P2["⑥ 开仓有效期到期 · Step2"]
        P3["上限 / 风控 · 同 Step2"]
        RULE1["规则：过期待回收 += 当时占用额<br/>占用 → 0 · 卡券 → 已失效"]
    end

    PENDING["过期待回收占用保证金<br/>（卡券 = 已失效）"]

    subgraph 减少["过期待回收 － 减少（仅清算）"]
        direction TB
        M1["② 激活新券 · Step2–3"]
        M2["④ 平仓 · Step2b（券已失效）"]
        M3["⑤ 本金划入 · Step2"]
        RULE2["规则：过期待回收 ↓<br/>等量记入 已回收"]
    end

    R["已回收体验金金额"]

    subgraph 不变["过期待回收 — 不变"]
        direction TB
        N1["① 首次激活 / 开仓"]
        N2["④ 平仓 · Step2a（券仍有效）"]
        N3["③ Step1 · ⑤ Step1"]
    end

    O -->|"触发回收"| PENDING
    P1 --> RULE1
    P2 --> RULE1
    P3 --> RULE1
    RULE1 --> PENDING

    PENDING -->|"清算"| R
    M1 --> RULE2
    M2 --> RULE2
    M3 --> RULE2
    RULE2 --> R

    style PENDING fill:#fff7ed,stroke:#fdba74
    style 新增 fill:#fef2f2,stroke:#fca5a5
    style 减少 fill:#ecfdf5,stroke:#6ee7b7
